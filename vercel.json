{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "github": { "enabled": true },
  "redirects": [
    { "source": "/staff-login", "destination": "/", "permanent": true },
    { "source": "/staff-login.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "(.*)\\.(css|js|png|jpg|jpeg|gif|webp)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}

